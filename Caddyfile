{
	admin off
	auto_https off
}

# Public entry point (published on HTTP_PORT). HTTPS comes from the Cloudflare
# Tunnel in F0 and from Caddy itself once there is a domain (F1).
:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			# Keep SSE streams open (job progress).
			flush_interval -1
		}
	}

	# Signed S3 URLs (uploads/downloads) go straight to the storage service.
	# The Host header and path are preserved, so signatures stay valid.
	handle /{$S3_BUCKET}/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy storage:9000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		# Bundles have a content hash in the name (main-T5U3DZTA.js) and can be cached
		# for long. Everything else (translations, the page shell, app routes served
		# as index.html) keeps its name between releases and must be revalidated, or
		# users see raw translation keys after an update.
		@hashed path_regexp [-.][0-9A-Za-z_]{8,}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path_regexp [-.][0-9A-Za-z_]{8,}\.(js|css)$
		header @revalidate Cache-Control "no-cache"
		file_server
	}
}

# Internal load balancer for the R processes (not published to the host).
:8001 {
	reverse_proxy stats-r:8000 stats-r-2:8000 {
		lb_policy least_conn
		lb_try_duration 5s
		health_uri /health
		health_interval 15s
		fail_duration 30s
	}
}
