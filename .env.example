# RevisaMeta - environment variables
# Copy to .env and replace every "change-me" value. Never commit .env.

# --- General ---------------------------------------------------------------
# Compose profile: "full" starts 2 R processes; use --profile lite for 1.
COMPOSE_PROFILES=full
APP_ENV=development
# Public URL users open (tunnel or domain). Used in e-mail links and CORS.
APP_BASE_URL=http://localhost:8080
# Contact e-mail shown in the terms of use and privacy policy (LGPD and removal requests).
LEGAL_CONTACT_EMAIL=
# Comma-separated hosts accepted by the backend (add the tunnel host here).
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8080
# Port Caddy listens on in the host machine.
HTTP_PORT=8080

# --- Security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=14
# Set to true only when served over HTTPS (tunnel or domain).
COOKIE_SECURE=false

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=revisameta
POSTGRES_USER=revisameta
POSTGRES_PASSWORD=change-me

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- File storage (RustFS, S3-compatible; ADR-004) -------------------------
S3_ACCESS_KEY=revisameta
S3_SECRET_KEY=change-me-min-8-chars
S3_BUCKET=revisameta-files
# Origin the browser uses for signed URLs. Caddy forwards /<bucket>/* to the
# storage service, so this must be the same origin users open (APP_BASE_URL).
S3_PUBLIC_ENDPOINT=http://localhost:8080
PDF_MAX_SIZE_MB=100
UPLOAD_PART_SIZE_MB=10

# --- Statistics service (R) ------------------------------------------------
STATS_R_URL=http://stats-r:8000
STATS_R_TIMEOUT_SECONDS=60

# --- E-mail ----------------------------------------------------------------
# Development uses Mailpit (web inbox at http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RevisaMeta <no-reply@revisameta.local>
SMTP_TLS=false

# --- Captcha (Cloudflare Turnstile) ----------------------------------------
TURNSTILE_ENABLED=false
# Cloudflare's public test keys (always pass). Replace with real keys in F1.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Default quotas (system admin can change per user) ---------------------
QUOTA_PROJECTS_PER_USER=5
QUOTA_STORAGE_MB_PER_USER=2048

# --- Backup ----------------------------------------------------------------
# Passphrase used to encrypt backups before they leave the machine.
BACKUP_PASSPHRASE=change-me
# Off-site copy (optional). Configure once with scripts/backup-setup-remote.sh,
# then set the remote and folder, e.g. gdrive:revisameta-backups
BACKUP_RCLONE_REMOTE=
# Healthchecks.io ping URL (optional, free): alerts if the daily backup did not run.
BACKUP_HEALTHCHECK_URL=

# AI (docs/ia.md, stage 7). Off by default: "none" | "gemini" | "fake" (tests only).
# The Gemini key comes from Google AI Studio (free, no card); restrict it to the Gemini
# API. On the free tier Google may use prompts and answers to improve its products,
# which is why each project must accept the data-use notice before using it.
AI_PROVIDER=none
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_CALLS_PER_USER_DAY=30
AI_CALLS_PER_MINUTE=10
AI_CALLS_PER_DAY=200
AI_MIN_ACCURACY=0.8
AI_ACCURACY_WINDOW=30
AI_ACCURACY_MIN_DECIDED=10
